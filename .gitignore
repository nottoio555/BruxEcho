# Recordings and generated outputs — regenerated locally, kept out of git.
# Directory placeholders (.gitkeep) stay tracked so the folder structure ships.
data/**
!data/**/
!data/**/.gitkeep

results/**
!results/**/
!results/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Android build output / local SDK config — regenerated by Gradle, machine-specific.
android/build/
android/app/build/
android/.gradle/
android/local.properties

# Verification screenshots from the manual test loop — regenerated locally.
shots/

# Claude Code session-local state — not project content.
.claude/
